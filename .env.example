# Frontend environment variables.
#
# Local development leaves this UNSET: the Vite dev server proxies /api to the
# local backend at http://127.0.0.1:8000 (see vite.config.ts).
#
# For a production deploy (Vercel/Netlify), set VITE_API_BASE to the public URL
# of the deployed FastAPI backend, e.g.:
# VITE_API_BASE=https://thermalloop-backend.onrender.com
VITE_API_BASE=
